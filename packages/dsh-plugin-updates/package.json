{
  "name": "@wha7ever/dsh-plugin-updates",
  "version": "0.1.0",
  "description": "Checks installed DSH plugins for newer npm or GitHub versions and shows the updates on the Plugins page",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "bun test/semver.test.mjs && bun test/sources.test.mjs && bun test/host.test.mjs && bun test/client.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wha7ev9r/dsh-kit.git",
    "directory": "packages/dsh-plugin-updates"
  },
  "bugs": {
    "url": "https://github.com/wha7ev9r/dsh-kit/issues"
  },
  "homepage": "https://github.com/wha7ev9r/dsh-kit/tree/main/packages/dsh-plugin-updates#readme",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "updates",
    "npm",
    "plugin-manager"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
