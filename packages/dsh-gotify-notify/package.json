{
  "name": "@wha7ever/dsh-gotify-notify",
  "version": "0.1.3",
  "description": "Gotify push alerts for DeepSeek Harness: get pinged when the harness asks you a question, waits for an approval, finishes a turn, or fails",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "bun test/host.test.mjs && bun test/client.test.mjs && bun test/waterfall.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wha7ev9r/dsh-kit.git",
    "directory": "packages/dsh-gotify-notify"
  },
  "bugs": {
    "url": "https://github.com/wha7ev9r/dsh-kit/issues"
  },
  "homepage": "https://github.com/wha7ev9r/dsh-kit/tree/main/packages/dsh-gotify-notify#readme",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "gotify",
    "notification",
    "alert"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
