{
  "name": "@wha7ever/dsh-kit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "A public monorepo for wha7ev9r's DeepSeek Harness plugins and themes",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": ["packages/*"],
  "scripts": {
    "check": "bun scripts/check-workspace.mjs",
    "test:updates": "bun packages/dsh-plugin-updates/test/semver.test.mjs && bun packages/dsh-plugin-updates/test/sources.test.mjs && bun packages/dsh-plugin-updates/test/host.test.mjs && bun packages/dsh-plugin-updates/test/client.test.mjs",
    "audit": "BUN_CONFIG_REGISTRY=https://registry.npmjs.org bun audit --audit-level=high"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": "^22.19.0 || >=24.0.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
